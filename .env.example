# Copy to .env for local development. Never commit .env.

# Owner/admin connection: used only for migrations, seeding, and test setup.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/wallet

# Passwords for the two application roles created by `pnpm db:setup`.
# wallet_app    — RLS-bound, read-only on ledger tables (what the apps use)
# wallet_ledger — RLS-bound, the ONLY role that can insert money movements
#                 (only packages/ledger receives this credential)
WALLET_APP_PASSWORD=wallet_app_dev
WALLET_LEDGER_PASSWORD=wallet_ledger_dev
